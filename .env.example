FYERS_APP_ID=
FYERS_SECRET=
FYERS_REDIRECT_URI=https://api.trading.quantumvora.com/api/auth/callback
FYERS_ACCESS_TOKEN=
FYERS_REFRESH_TOKEN=
# Market-data host (candles). The SDK keeps this separate from API v3.
FYERS_DATA_URL=https://api-t1.fyers.in/data
# Web terminal origin, e.g. https://trading.quantumvora.com — where the browser
# returns after a successful Fyers login.
FRONTEND_URL=

BROKER_MODE=fyers
PAPER_TRADING=true

DEBUG=false
LOG_LEVEL=INFO
# Key for scripts / the MCP client (X-Admin-Key). Optional with sign-in.
ADMIN_SECRET_KEY=
# Dashboard sign-in with a 6-digit PIN (only its hash is kept here).
# Set it up with: python -m utils.auth set-pin
ADMIN_PIN_HASH=
SESSION_HOURS=168
